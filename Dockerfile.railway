# Railway build target for OpenEMR.
#
# WHY THIS EXISTS: Railway's default builder (Nixpacks) cannot build the OpenEMR
# monorepo, so `railway up` fails. Instead of rebuilding the heavy multi-stage
# docker/flex/Dockerfile on every deploy (slow, and it can build the wrong
# stage), this deploys the PREBUILT official "flex" image — near-zero build.
#
# The flex image fetches OpenEMR source at runtime from the FLEX_REPOSITORY /
# FLEX_REPOSITORY_BRANCH env vars and serves it via Apache on port 80. Set those
# (and the MYSQL_* / OE_* vars) in the Railway service, and point Railway's
# exposed/target port at 80.
#
# Pin to a digest for reproducible deploys if you want, e.g.:
#   FROM openemr/openemr:flex@sha256:<digest>
FROM openemr/openemr:flex

# The stock flex entrypoint (openemr.sh) assumes the source repository is named
# "openemr": it clones FLEX_REPOSITORY (whose dir defaults to the repo's name)
# and then rsyncs a HARDCODED "openemr" directory into the webroot. This fork's
# repo has a different name (agent-forge), so the stock script clones into
# "agent-forge" and the rsync fails ("/openemr: No such file or directory").
# Overlay this fork's openemr.sh, which clones into an explicit "openemr" dir.
COPY docker/flex/openemr.sh /var/www/localhost/htdocs/openemr.sh
RUN chmod 500 /var/www/localhost/htdocs/openemr.sh
